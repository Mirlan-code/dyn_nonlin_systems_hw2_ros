<?xml version="1.0"?>
<robot name="excavator">

  <material name="yellow">
    <color rgba="1.0 0.75 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.1"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="turret_joint" type="continuous">
    <parent link="base_link"/>
    <child link="turret"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="turret">
    <visual>
      <origin xyz="0 0 0.35" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.7"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <joint name="boom_joint" type="revolute">
    <parent link="turret"/>
    <child link="boom"/>
    <origin xyz="0 0 0.7" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <link name="boom">
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="1.0"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <joint name="stick_joint" type="revolute">
    <parent link="boom"/>
    <child link="stick"/>
    <origin xyz="0 0 1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.4" upper="2.4" effort="100" velocity="1.0"/>
  </joint>

  <link name="stick">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="bucket_joint" type="revolute">
    <parent link="stick"/>
    <child link="bucket"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2" upper="2" effort="100" velocity="1.0"/>
  </joint>

  <link name="bucket">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.1 0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="tip_joint" type="fixed">
    <parent link="bucket"/>
    <child link="tip"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <link name="tip">
  </link>

</robot>